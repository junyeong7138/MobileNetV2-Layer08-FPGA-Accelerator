        <mxCell id="bk7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="BANK[7] : 196칸 × 32b&#xa;담당 필터 = f_tile×8+7" vertex="1">
          <mxGeometry height="55" width="270" x="1256" y="345" as="geometry" />
        </mxCell>
        <mxCell id="accnote" parent="1" style="text;html=1;fontSize=11;align=left;" value="칸 p = 위치 p의 부분합&#xa;ch_tile 0: 그대로 저장 (bypass)&#xa;ch_tile 1~6: 읽고 더해 다시 저장&#xa;ch_tile 7: 64채널 완성 → 배출!" vertex="1">
          <mxGeometry height="80" width="280" x="1256" y="410" as="geometry" />
        </mxCell>
        <mxCell id="outp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="④ 출력 스트림 (제출판)&#xa;out_valid[7:0]&#xa;out_data 8×32b (스케일 2⁻²⁸)&#xa;out_pos 0~195&#xa;= 필터별·위치별 64채널 내적" vertex="1">
          <mxGeometry height="130" width="250" x="1693" y="230" as="geometry" />
        </mxCell>
        <mxCell id="pp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;fontSize=11;" value="(다음 단계) Post_Proc&lt;br&gt;bias → ReLU6 → ≫15 → UQ3.13&lt;br&gt;구현 예정" vertex="1">
          <mxGeometry height="80" width="250" x="1693" y="400" as="geometry" />
        </mxCell>
        <mxCell id="e_b_sa" edge="1" parent="1" source="bmem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0.5;entryY=0;strokeWidth=2;" target="sa" value="① LOAD: 클럭당 128b = 한 행(8열 가중치) × 8클럭&#xa;주소 = (f_tile×8 + ch_tile)×8 + load_cnt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a_skew" edge="1" parent="1" source="amem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeWidth=2;" target="skew" value="② CALC: 클럭당 128b&#xa;= 한 위치의 8채널&#xa;주소 = ch_tile×196 + calc_cyc_cnt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_skew_sa" edge="1" parent="1" source="skew" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;entryX=0;entryY=0.6;strokeWidth=2;" target="sa" value="계단 정렬된&#xa;8×16b (Q3.12)">
