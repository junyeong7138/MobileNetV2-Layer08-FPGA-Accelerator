        <mxCell id="e_sa_acc" edge="1" parent="1" source="sa" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" target="acc" value="열 바닥 psum 8×32b, 매 클럭 (f=28)&#xa;열 j는 j클럭 늦게 → 주소로 de-skew&#xa;첫 psum은 CALC+13클럭 (8+4+1)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_acc_out" edge="1" parent="1" source="acc" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.4;strokeWidth=2;" target="outp" value="마지막 ch_tile에서&#xa;완성값 스트림 배출">
