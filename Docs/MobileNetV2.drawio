        <mxCell id="nRXFRA7O3NYvN6sOTNDS-106" parent="1" style="text;html=1;fontSize=10;align=left;fontColor=#666666;" value="└ 여기까지 타일(0,0) = 필터0~7 × 채널0~7 — LOAD 8클럭에 주소 +1씩 읽으면 끝" vertex="1">
          <mxGeometry height="20" width="590" x="1240" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="nRXFRA7O3NYvN6sOTNDS-107" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" value="addr 8~15 : 타일(0,1) = 필터0~7 × 채널8~15   /   ⋯   /   addr 3,071까지 (타일 384개×8워드)" vertex="1">
          <mxGeometry height="30" width="690" x="1140" y="1078" as="geometry" />
        </mxCell>
        <mxCell id="nRXFRA7O3NYvN6sOTNDS-108" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#888888;" value="[127:112]=필터7  |  …  |  [15:0]=필터0   ← SA w_in에 그대로 직결" vertex="1">
          <mxGeometry height="20" width="590" x="1240" y="734" as="geometry" />
        </mxCell>
        <mxCell id="nRXFRA7O3NYvN6sOTNDS-109" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="★ 같은 값의 이동: 원본 idx 7 (필터0·ch7)  →  COE addr 0의 맨 오른쪽 칸&#xa;addr0(ch7용)을 먼저 넣는 이유: shift-in에서 먼저 들어간 줄이 바닥(행7)까지 밀리므로&#xa;최종 배치: PE(i,j).w_reg = 원본[(8·f_tile+j)×64 + (8·c_tile+i)]  — 하드웨어는 &#39;주소+1&#39; 8번이 전부" vertex="1">
          <mxGeometry height="74" width="690" x="1140" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="nRXFRA7O3NYvN6sOTNDS-110" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=center;" value="가중치 재배열 — 원본(필터 단위 나열) → 우리 COE(타일·워드 단위)  ※ C 유틸이 오프라인에서 수행" vertex="1">
          <mxGeometry height="30" width="1440" x="820" y="570" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pw_example" name="숫자예시(디버그셋)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="x0" value="값 하나가 완성되는 과정 — 디버그 데이터셋 예시 (필터 0, 위치 p: p%4=2 → 입력 2.0)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="입력 (A 메모리)&#xa;위치 p의 8채널&#xa;= 전부 2.0 (Q3.12: 0x2000)&#xa;※ 64채널 전체도 2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="가중치 (B 메모리)&#xa;필터 0의 64개&#xa;= 전부 +0.03125 (0x0800)&#xa;→ SA 열 0의 w_reg 8개에 고정" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="SA 열 0 (한 채널 타일)&#xa;&#xa;psum = Σ (2.0 × 0.03125) × 8행&#xa;      = 0.0625 × 8 = 0.5&#xa;&#xa;→ 매 타일마다 열 바닥에서&#xa;   &quot;8채널 몫&quot; 0.5가 나옴" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="x4" value="BANK[0]의 칸 p — 8번에 걸쳐 완성&#xa;&#xa;ch_tile 0 :          0.5   (bypass 저장)&#xa;ch_tile 1 : 0.5+0.5 = 1.0&#xa;ch_tile 2 : 1.0+0.5 = 1.5&#xa;ch_tile 3 : 1.5+0.5 = 2.0&#xa;ch_tile 4 : 2.0+0.5 = 2.5&#xa;ch_tile 5 : 2.5+0.5 = 3.0&#xa;ch_tile 6 : 3.0+0.5 = 3.5&#xa;ch_tile 7 : 3.5+0.5 = 4.0  ← 완성!" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="100" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="x5" value="출력 (out_valid[0]=1)&#xa;out_data[0] = 4.0&#xa;(코드 4×2²⁸ = 0x4000_0000)&#xa;&#xa;검산: 64ch × 2.0 × 0.03125 = 4.0 ✓&#xa;파형 Fixed Point(28)로 &quot;4.0&quot; 표시" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="130" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="xe1" value="CALC: 위치 p 스트리밍&#xa;(타일마다 다른 8채널)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="x1" target="x3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xe2" value="LOAD: 타일마다&#xa;다음 8개 가중치 교체" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="x2" target="x3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xe3" value="타일당 0.5 (f=28 psum)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="x3" target="x4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xe4" value="last_ch_tile에서 배출" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="x4" target="x5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x6" value="※ 실데이터에서는 입력·가중치가 픽셀/채널마다 달라질 뿐 과정은 동일.&#xa;※ 홀수 필터(BANK[1,3,5,7])는 가중치 부호가 반대라 -0.5씩 쌓여 -4.0으로 완성 — 파형에서 열 구분용.&#xa;※ 위치 p%4 = 0/1/2/3 이면 입력이 1.0/1.5/2.0/2.5 → 완성값 2.0/3.0/4.0/5.0." style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1100" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
