          <mxGeometry height="55" width="270" x="1256" y="185" as="geometry" />
        </mxCell>
        <mxCell id="bk1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="BANK[1] : 196칸 × 32b&#xa;담당 필터 = f_tile×8+1" vertex="1">
          <mxGeometry height="55" width="270" x="1256" y="250" as="geometry" />
